{
  "description": "Container run profiles (registry/run-profiles.json, docs/images-and-ownership.md section 5, SEC-15). `options` are the arguments of `docker run` between `run` and the image reference. `after_image` are the arguments after the image reference (none when absent). A run conforms when every option group of the profile occurs exactly once, every other token belongs to one of its other_options groups, each placeholder token matches its parameter, and nothing follows the image reference. Names, labels and limit values are examples.",
  "cases": [
    {"name": "diagnostic-hardened", "note": "the limit values are examples", "profile": "diagnostic", "options": ["--detach", "--pull=never", "--network", "none", "--cap-drop", "ALL", "--security-opt", "no-new-privileges", "--read-only", "--pids-limit", "128", "--memory", "512m", "--name", "sprut-diagnostic-0a1b2c", "--label", "io.github.alexindacomp.sprut.managed=true", "--label", "io.github.alexindacomp.sprut.profile=default"], "expected": "conforming"},
    {"name": "diagnostic-groups-in-another-order", "note": "groups may come in any order", "profile": "diagnostic", "options": ["--name", "sprut-diagnostic-0a1b2c", "--memory", "512m", "--pids-limit", "128", "--read-only", "--security-opt", "no-new-privileges", "--cap-drop", "ALL", "--network", "none", "--pull=never", "--detach", "--label", "io.github.alexindacomp.sprut.managed=true", "--label", "io.github.alexindacomp.sprut.profile=default"], "expected": "conforming"},
    {"name": "diagnostic-without-network-none", "profile": "diagnostic", "options": ["--detach", "--pull=never", "--cap-drop", "ALL", "--security-opt", "no-new-privileges", "--read-only", "--pids-limit", "128", "--memory", "512m", "--name", "sprut-diagnostic-0a1b2c", "--label", "io.github.alexindacomp.sprut.managed=true", "--label", "io.github.alexindacomp.sprut.profile=default"], "expected": "non_conforming"},
