    {"name": "diagnostic-network-none-then-host", "note": "a second --network would override the first", "profile": "diagnostic", "options": ["--detach", "--pull=never", "--network", "none", "--cap-drop", "ALL", "--security-opt", "no-new-privileges", "--read-only", "--pids-limit", "128", "--memory", "512m", "--name", "sprut-diagnostic-0a1b2c", "--label", "io.github.alexindacomp.sprut.managed=true", "--label", "io.github.alexindacomp.sprut.profile=default", "--network", "host"], "expected": "non_conforming"},
