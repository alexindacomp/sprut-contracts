    {"name": "managed-not-true", "owned": false, "labels": {"io.github.alexindacomp.sprut.managed": "TRUE", "io.github.alexindacomp.sprut.profile": "default"}},
    {"name": "profile-differs-in-case", "note": "values compare exactly", "owned": false, "labels": {"io.github.alexindacomp.sprut.managed": "true", "io.github.alexindacomp.sprut.profile": "Default"}},
    {"name": "lookalike-namespace", "note": "a key that only starts like the namespace is not a Sprut label", "owned": false, "labels": {"io.github.alexindacomp.sprutx.managed": "true", "io.github.alexindacomp.sprutx.profile": "default"}}
