{
  "description": "Execution preconditions of plan steps (registry/plan-step-kinds.json). `step` shows only the members the preconditions use; `observed` are facts read right before the step runs, never from the journal. Hashes are examples.",
  "cases": [
    {"name": "wsl-restart-confirmed-after-drain", "platform": "windows", "step": {"kind": "restart_wsl"},
     "observed": {"sprut_drained": true, "wsl_restart_confirmed": true}, "expected": "allowed"},
    {"name": "wsl-restart-not-confirmed", "note": "CR04: plan consent alone never restarts WSL", "platform": "windows", "step": {"kind": "restart_wsl"},
     "observed": {"sprut_drained": true, "wsl_restart_confirmed": false},
     "expected": "rejected", "reason_code": "WSL_RESTART_REQUIRED", "expected_next_state": "ACTION_REQUIRED", "expected_event": "state"},
    {"name": "wsl-restart-before-drain", "platform": "windows", "step": {"kind": "restart_wsl"},
     "observed": {"sprut_drained": false, "wsl_restart_confirmed": true},
     "expected": "rejected", "reason_code": "WSL_RESTART_REQUIRED", "expected_next_state": "ACTION_REQUIRED", "expected_event": "state"},
    {"name": "wsl-restart-facts-missing", "platform": "windows", "step": {"kind": "restart_wsl"}, "observed": {},
     "expected": "rejected", "reason_code": "WSL_RESTART_REQUIRED", "expected_next_state": "ACTION_REQUIRED", "expected_event": "state"},
    {"name": "wslconfig-unchanged", "platform": "windows",
     "step": {"kind": "write_wslconfig", "wslconfig": {"memory": "8GB"}, "wslconfig_file": {"sha256": "1f2e3d4c5b6a79881f2e3d4c5b6a79881f2e3d4c5b6a79881f2e3d4c5b6a7988", "replaced": {"memory": "4GB"}}},
     "observed": {"wslconfig_sha256": "1f2e3d4c5b6a79881f2e3d4c5b6a79881f2e3d4c5b6a79881f2e3d4c5b6a7988"}, "expected": "allowed"},
    {"name": "wslconfig-still-absent", "platform": "windows",
