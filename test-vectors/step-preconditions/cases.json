     "observed": {"running_distributions": ["Ubuntu", "sprut"], "sprut_drained": true, "wsl_restart_confirmed": true}, "expected": "allowed"},
    {"name": "wsl-restart-not-confirmed", "note": "CR04: plan consent alone never restarts WSL", "platform": "windows", "step": {"kind": "restart_wsl"},
     "observed": {"running_distributions": ["Ubuntu", "sprut"], "sprut_drained": true, "wsl_restart_confirmed": false},
