{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alexindacomp/sprut-contracts/schemas/effect-vector.schema.json",
  "title": "Effect precondition test vectors",
  "description": "Format of test-vectors/effects/*.json. Each case evaluates the checks of one effect of `machine` (on, state, action) against `context` (names from the machine's guard_context). expected=applied: every check holds and the effect happens. expected=rejected: the first failing check gives reason_code, the effect does not happen (for set_consented_plan_id: consent stays unset), the operation stays in `state` and emits an event of type expected_event.",
  "type": "object",
  "required": ["machine", "description", "cases"],
  "additionalProperties": false,
  "properties": {
    "machine": {"type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"},
    "description": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "on", "state", "action", "context", "expected"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
          "note": {"type": "string", "minLength": 1},
          "on": {"enum": ["enter_state", "user_consent"]},
          "state": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"},
          "action": {"type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"},
          "context": {"type": "object"},
          "expected": {"enum": ["applied", "rejected"]},
          "reason_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"},
          "expected_event": {"enum": ["error", "state"]}
        },
        "if": {"properties": {"expected": {"const": "rejected"}}, "required": ["expected"]},
        "then": {"required": ["reason_code", "expected_event"]},
        "else": {"not": {"anyOf": [{"required": ["reason_code"]}, {"required": ["expected_event"]}]}}
      }
    }
  }
}
