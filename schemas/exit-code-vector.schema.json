{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alexindacomp/sprut-contracts/schemas/exit-code-vector.schema.json",
  "title": "CLI exit-code resolution test vectors",
  "description": "Format of test-vectors/exit-codes/*.json. Applying resolution.rules of registry/exit-codes.json to input must give exit_code. reason_code and operation may be unregistered on purpose (newer contracts). final_state requires operation; succeeded=true is only valid with no final_state or a state in succeeded_final_states.",
  "type": "object",
  "required": ["description", "cases"],
  "additionalProperties": false,
  "properties": {
    "description": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "input", "exit_code"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
          "note": {"type": "string", "minLength": 1},
          "input": {
            "type": "object",
            "required": ["interactive"],
            "additionalProperties": false,
            "properties": {
              "usage_error": {"type": "boolean"},
              "interrupted": {"type": "boolean"},
              "incomplete": {"type": "boolean"},
              "succeeded": {"type": "boolean"},
              "operation": {"description": "Operation kind (operation_kinds); may be unregistered on purpose.", "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"},
              "final_state": {"description": "Authoritative state of the operation at command end (journal/core), not the last event.", "type": "string", "pattern": "^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"},
              "reason_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"},
              "interactive": {"type": "boolean"}
            }
          },
          "exit_code": {"type": "integer", "minimum": 0, "maximum": 255}
        }
      }
    }
  }
}
